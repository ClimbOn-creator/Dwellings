{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dwelling-iq-app",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-08",
  "r2_buckets": [
    {
      "binding": "PROPERTY_FILES",
      "bucket_name": "dwellings",
      "preview_bucket_name": "dwellings"
    },
    {
      "binding": "LEARNING_MEDIA",
      "bucket_name": "affinity-learning-media",
      "preview_bucket_name": "affinity-learning-media"
    }
  ]
}
